				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "olist_order_payments_dataset.csv",
						"folderPath": "csv",
						"container": "input"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "order_id",
						"type": "String"
					},
					{
						"name": "payment_sequential",
